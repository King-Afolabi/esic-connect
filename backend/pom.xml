<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>com.esic.connect</groupId>
    <artifactId>esic-connect-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>esic-connect-backend</name>
    <description>ESIC Connect - back-end Spring Boot (monolithe modulaire)</description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>1.4.12</spring-modulith.version>
        <springdoc-openapi.version>3.1.0</springdoc-openapi.version>
        <!--
            Sélection des tests par tag JUnit (FINAL-009).
            Par défaut : on exécute tout SAUF le tag `perf` (mesures
            chronométrées, non déterministes). Le profil `-Pperf`
            surcharge ces deux propriétés pour n'exécuter QUE `perf`.
        -->
        <test.groups></test.groups>
        <test.excludedGroups>perf</test.excludedGroups>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Fournit JwtEncoder/JwtDecoder (Nimbus) : émission et validation
             standard des JWT (Spring Security OAuth2 Resource Server),
             sans filtre artisanal. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- Envoi des emails d'activation via un serveur SMTP local (Mailpit
             en développement). L'envoi reste synchrone après commit ; une
             file persistante avec reprise garantie est une dette technique
             assumée (docs/03-architecture.md §18, cahier §23.3). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <!-- Depuis Flyway 10, le support MySQL est extrait de flyway-core :
             ce module est indispensable pour migrer la base MySQL du projet. -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-mysql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc-openapi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <!--
                Les tests de mesure de performance (FINAL-009) portent le
                tag JUnit `perf` et sont EXCLUS du `mvn test` par défaut
                (voir les propriétés `test.groups` / `test.excludedGroups`).
                Version du plugin gérée par spring-boot-starter-parent.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <groups>${test.groups}</groups>
                    <excludedGroups>${test.excludedGroups}</excludedGroups>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!--
            `./mvnw test -Pperf` : n'exécute QUE les tests taggés `perf`
            (mesures reproductibles, voir docs/reports/PERF_NOTES.md).
            `none` = tag qu'aucun test ne porte → exclusion neutralisée.
        -->
        <profile>
            <id>perf</id>
            <properties>
                <test.groups>perf</test.groups>
                <test.excludedGroups>none</test.excludedGroups>
            </properties>
        </profile>
    </profiles>
</project>
