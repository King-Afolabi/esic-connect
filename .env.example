COMPOSE_PROJECT_NAME=esic-connect

# Base applicative / de démonstration utilisée par le RUNTIME Spring
# (profils `local` et `demo`). Pour une démonstration isolée :
# MYSQL_DATABASE=esic_connect_demo
MYSQL_DATABASE=esic_connect
# Base utilisée par la SUITE DE TESTS backend (profil `test`) — distincte
# de MYSQL_DATABASE pour qu'un `./mvnw test` n'écrive jamais dans la base
# applicative ni dans la base de démonstration. Défaut : esic_test.
MYSQL_TEST_DATABASE=esic_test
MYSQL_USER=esic_app
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-me
MYSQL_PORT=3306

REDIS_PORT=6379
REDIS_PASSWORD=change-redis-me

MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

MQTT_PORT=1883
MQTT_WEBSOCKET_PORT=9001

JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# Invitation / activation de compte
MAIL_HOST=localhost
MAIL_PORT=1025
APP_MAIL_FROM=no-reply@esic-connect.test
APP_ACTIVATION_BASE_URL=http://localhost:4200/activation
# Durée ISO-8601 (défaut P30D = 30 jours), strictement positive
INVITATION_TOKEN_TTL=P30D

# Émargement : durée de vie d'un jeton dynamique / code court dans Redis.
# Durée ISO-8601, strictement positive (défaut PT30S = 30 secondes).
ATTENDANCE_TOKEN_TTL=PT30S

# Démonstration (profil `demo` uniquement) : mot de passe des comptes
# fictifs (admin / formateur / apprenants). Obligatoire pour lancer le
# profil `demo`, au moins 12 caractères. Secret LOCAL, jamais commité.
ESIC_DEMO_PASSWORD=

# Démonstration (profil `demo` uniquement) : secret TOTP déterministe
# (base32, RFC 4648) pour les comptes ADMIN/SUPER_ADMIN fictifs.
# STRICTEMENT OPTIONNEL — absent, ces deux comptes restent bloqués à
# l'écran d'enrôlement (comportement inchangé). Renseigné, il permet à
# `scripts/seed-demo.sh` et à `npm run test:e2e` de franchir le second
# facteur réel avec un code calculé localement (dette T-19/T-20). N'a
# d'effet que sous le profil `demo` ; sans effet sous tout autre profil,
# y compris en production. Valeur LOCALE uniquement, jamais commitée, et
# jamais une valeur de production. Exemple de valeur (fictive, à générer
# vous-même en local, ex. `openssl rand -base32 20 | tr -d '='` puis en
# majuscules) : ESIC_DEMO_TOTP_SECRET=JBSWY3DPEHPK3PXP
ESIC_DEMO_TOTP_SECRET=

BACKEND_PORT=8080
FRONTEND_PORT=4200
AI_SERVICE_PORT=8000

UPLOAD_DIRECTORY=/data/uploads

# Pièces jointes des justificatifs d'absence (bloc G1-E). Le CONTENU des
# fichiers est stocké HORS webroot, jamais en base. Optionnel : par
# défaut `${UPLOAD_DIRECTORY}/justifications`. Sur un déploiement à
# système de fichiers éphémère, monter un volume persistant.
# JUSTIFICATION_STORAGE_PATH=
# Taille maximale d'une pièce jointe en octets (défaut 5242880 = 5 Mo).
# JUSTIFICATION_MAX_FILE_BYTES=5242880
# Analyse antivirus des pièces jointes (EF-JUS-002). Désactivée par
# défaut : sans analyseur, chaque pièce est marquée NOT_SCANNED et l'API
# l'expose — le produit ne prétend jamais qu'un fichier est sain.
# Pour l'activer en local : `docker compose --profile antivirus up -d`
# puis ANTIVIRUS_ENABLED=true.
# ANTIVIRUS_ENABLED=false
# ANTIVIRUS_HOST=localhost
# ANTIVIRUS_PORT=3310
# ANTIVIRUS_TIMEOUT_MILLIS=10000
# ANTIVIRUS_REQUIRED=true met en quarantaine (non téléchargeable) toute
# pièce sans verdict. N'activer qu'avec un analyseur réellement joignable.
# ANTIVIRUS_REQUIRED=false

# Balayage des fichiers orphelins du stockage des justificatifs
# (docs/02 §19.5). Désactiver si le répertoire est partagé.
# JUSTIFICATION_ORPHAN_SWEEP_ENABLED=true
# JUSTIFICATION_ORPHAN_SWEEP_BATCH=500

# Réconciliation TECHNIQUE des pièces jointes restées PENDING_STORAGE
# (crash entre le commit et la bascule STORED). Distincte de toute
# rétention métier. Défauts : PT15M / lot 100 / toutes les 10 min.
# JUSTIFICATION_RECONCILIATION_AFTER=PT15M
# JUSTIFICATION_RECONCILIATION_BATCH=100
# JUSTIFICATION_RECONCILIATION_CRON=0 */10 * * * *
# Taille maximale d'un téléversement multipart (bornage servlet). Doit
# rester >= JUSTIFICATION_MAX_FILE_BYTES + marge d'enveloppe. Défaut 6MB.
# MULTIPART_MAX_FILE_SIZE=6MB
# MULTIPART_MAX_REQUEST_SIZE=7MB

SPRING_PROFILES_ACTIVE=local
# Origines autorisées à appeler l'API depuis un navigateur (CORS).
# Liste séparée par des virgules, jamais `*`. En local, `ng serve`
# proxifie `/api` (aucune requête cross-origin) ; cette valeur ne sert
# qu'à un déploiement où le front est servi depuis un autre origin.
# Lu par SecurityConfig (app.security.cors.allowed-origins).
APP_ALLOWED_ORIGINS=http://localhost:4200
AI_SERVICE_URL=http://localhost:8000
MQTT_BROKER_URL=tcp://localhost:1883

# ---------------------------------------------------------------------
# Authentification forte — sprint 2 (EF-AUTH-006 à EF-AUTH-013)
# ---------------------------------------------------------------------

# Chiffrement AES-GCM des secrets TOTP au repos. AUCUNE valeur ici : un
# secret n'entre jamais dans le dépôt. Si la variable est absente, la clé
# est dérivée du secret JWT — acceptable en local, à renseigner en
# production (un avertissement est journalisé au démarrage).
MFA_ENCRYPTION_KEY=

# Rôles pour lesquels le second facteur est OBLIGATOIRE (RG-007, AC-021).
# Défaut : SUPER_ADMIN,ADMIN. Peut être étendu, jamais vidé sans décision
# documentée.
# APP_SECURITY_MFA_REQUIRED_ROLES=SUPER_ADMIN,ADMIN
# Durée de vie d'un défi de second facteur (ISO-8601, défaut PT5M).
# APP_SECURITY_MFA_CHALLENGE_TTL=PT5M
# Tolérance de dérive d'horloge, en pas de 30 s (défaut 1).
# APP_SECURITY_MFA_STEP_TOLERANCE=1

# Durée pendant laquelle un appareil reste reconnu (EF-AUTH-013).
# APP_SECURITY_TRUSTED_DEVICE_DURATION=P30D

# WebAuthn / clés d'accès (EF-AUTH-006, EF-AUTH-007).
#
# CONTRAINTE DU STANDARD : le `rp-id` doit être le domaine de
# l'application, et l'origine doit être servie en HTTPS — sauf
# `localhost`, que les navigateurs considèrent comme un contexte sûr.
# C'est ce qui rend le développement possible sans certificat, et ce qui
# impose un NOM DE DOMAINE et HTTPS avant tout usage hors du poste de
# développement.
# APP_SECURITY_WEBAUTHN_RP_ID=localhost
# APP_SECURITY_WEBAUTHN_RP_NAME=ESIC Connect
# APP_SECURITY_WEBAUTHN_ORIGINS=http://localhost:4200

# Anti-robot Cloudflare Turnstile (EF-AUTH-011).
#
# La clé de SITE est publique (elle s'affiche dans le HTML du widget) et
# peut donc figurer ici. La clé SECRÈTE ne doit JAMAIS être commitée :
# renseignez-la uniquement dans votre `.env` local, jamais dans ce
# modèle. Sans clé secrète, l'adaptateur local prend le relais et le
# produit déclare franchement, via `GET /api/v1/auth/captcha`, qu'aucun
# contrôle anti-robot n'est actif.
# Clé de site fournie par le porteur du produit pour le widget de
# démonstration (localhost déjà autorisé côté Cloudflare).
APP_SECURITY_CAPTCHA_SITE_KEY=0x4AAAAAAEmJ8JmFRqOSxo17
APP_SECURITY_CAPTCHA_SECRET_KEY=

# Nombre d'échecs de connexion au-delà duquel le contrôle anti-robot
# devient obligatoire (RG-092, AC-022 : « après trois échecs »).
# APP_SECURITY_LOGIN_CAPTCHA_AFTER_FAILURES=3
