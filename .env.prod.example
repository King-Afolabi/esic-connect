# Modèle pour le fichier .env de la Raspberry Pi (déploiement de test
# public via compose.prod.yaml). À COPIER en .env sur la Pi et à
# compléter avec de VRAIES valeurs locales — jamais commité (.gitignore).
#
#   cp .env.prod.example .env
#   nano .env
#   docker compose -f compose.prod.yaml up -d --build

COMPOSE_PROJECT_NAME=esic-connect

MYSQL_DATABASE=esic_connect_demo
MYSQL_USER=esic_app
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

REDIS_PASSWORD=

# >= 32 octets. Générer avec : openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TOKEN_TTL_SECONDS=900

# --- Démonstration (profil demo) ------------------------------------------
# Comptes fictifs (admin@example.test, formateur@example.test, etc.) pour
# guider les premiers testeurs. Second facteur déterministe pour
# ADMIN/SUPER_ADMIN (dette T-19/T-20) : optionnel mais recommandé pour que
# ces deux comptes de démo restent utilisables (sinon ils butent sur
# l'écran d'enrôlement MFA à chaque connexion, ce qui reste franchissable
# manuellement mais moins pratique pour une démonstration guidée).
SPRING_PROFILES_ACTIVE=demo
ESIC_DEMO_PASSWORD=
ESIC_DEMO_TOTP_SECRET=

# --- Email réel (EF-INT-004) — ex. Brevo -----------------------------------
# smtp-relay.brevo.com / 587 / identifiants SMTP du compte Brevo (PAS le
# mot de passe du compte : la "clé SMTP" générée dans Brevo > SMTP & API).
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
APP_MAIL_FROM=no-reply@VOTRE-DOMAINE.tld

# URL PUBLIQUE (celle donnée aux testeurs, via le tunnel Cloudflare) — les
# liens d'activation et de réinitialisation sont construits à partir de
# celle-ci. À mettre à jour dès que le domaine/tunnel est en service.
APP_ACTIVATION_BASE_URL=https://VOTRE-DOMAINE.tld/activation
# Origine autorisée à appeler l'API (CORS) : la même URL publique, sans
# le chemin. Jamais "*".
APP_ALLOWED_ORIGINS=https://VOTRE-DOMAINE.tld

# Relevé pour un usage multi-testeurs (défaut 60/15 min peut être trop
# bas si plusieurs personnes testent en même temps depuis la même
# origine réseau côté serveur — ce n'est PAS le cas ici car chaque
# testeur a sa propre IP publique ; le défaut convient donc, sauf test
# de charge volontaire).
LOGIN_ORIGIN_LIMIT=60

# --- Cloudflare Tunnel ------------------------------------------------------
# Jeton généré lors de la création du tunnel (dashboard Cloudflare Zero
# Trust > Networks > Tunnels > Create a tunnel > Docker). Secret local,
# jamais commité.
CLOUDFLARE_TUNNEL_TOKEN=
