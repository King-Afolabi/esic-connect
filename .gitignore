# Documentation interne : conservée en local, retirée du suivi Git public
# (passe d'assainissement 2026-09-14 ; sauvegarde hors dépôt avant retrait).
# Les règles historiques ci-dessous deviennent redondantes avec /docs/ mais
# restent au cas où l'exclusion globale serait un jour retirée.
/docs/
/artifacts/
/docs/audit/
/docs/JOURNAL-*.md
/docs/CURRENT-STATE.md
/docs/SOUTENANCE-*.md
/docs/anomalies/
/docs/demo-data/*-REPORT.md
/DECISIONS_NEEDED.md

# OpenAPI export (commodité de revue, non versionné — voir scripts/dump-openapi.sh)
docs/openapi.json

# Temporary imports
tmp/
temp/

# Fichiers locaux d'outillage / IDE / OS
.claude/
/CLAUDE.md

# État d'exécution local (URL publique du tunnel, etc.) — jamais versionné :
# l'URL *.trycloudflare.com est éphémère et n'est pas une URL de production.
/.local/

# Playwright / recette e2e navigateur
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
/captures/
frontend/out-tsc/

# Sauvegarde locale d'une version antérieure du dépôt, réalisée par le
# porteur de projet le 3 septembre 2026. Contenu identique à des fichiers
# déjà suivis par Git : ne jamais versionner (l'historique fait foi).
/Archives/
